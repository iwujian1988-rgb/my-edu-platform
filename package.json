{
  "name": "my-edu-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:safe": "node scripts/dev-safe-start.js",
    "dev:monitor": "node scripts/dev-monitor.js",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=4096' next dev --no-turbopack",
    "build": "next build",
    "start": "next start",
    "cleanup:cache": "node scripts/cleanup-cache.js",
    "test:oss": "node scripts/test-oss.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:logs": "grep -r \"console\\.log\" src/ | wc -l || echo 0",
    "type-check": "tsc --noEmit",
    "quality-check": "npm run lint && npm run type-check && npm run lint:logs",
    "ai-check": "node scripts/ai-quality-check.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs my-edu-platform",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "pm2:flush": "pm2 flush",
    "pm2:health": "node scripts/health-check.js",
    "memory:check": "node scripts/memory-check.js",
    "memory:monitor": "node scripts/memory-monitor.js",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:all": "node scripts/cleanup.js --all",
    "cleanup:node": "node scripts/cleanup.js --node-modules",
    "speaker:import": "npx tsx scripts/import-speaker-data.ts",
    "speaker:import:single": "npx tsx scripts/import-speaker-data.ts --file="
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.35.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "ali-oss": "^6.23.0",
    "async-retry": "^1.3.3",
    "canvas": "^3.2.1",
    "cefr-analyzer": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "global-agent": "^3.0.0",
    "handwriting.js": "^1.0.4",
    "ioredis": "^5.9.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "proxy-agent": "^5.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "^7.18.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5",
    "zod-validation-error": "^5.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "happy-dom": "^20.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "uipro-cli": "^1.3.0",
    "vitest": "^4.0.17"
  }
}
